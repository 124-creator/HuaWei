        <mxCell id="title" parent="1" vertex="1" value="&lt;div style=&quot;font-family:'Liberation Serif','WenQuanYi Zen Hei';line-height:1.48;&quot;&gt;问题二：驻留组织与 Spill 引导微批&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=WenQuanYi Zen Hei;fontSize=16.266666666666666;fontColor=#222222;fillColor=none;strokeColor=none;strokeWidth=1.2;spacing=5;" r12Role="text">
