        <mxCell id="stats" value="五核平均加速比 &lt;span style=&quot;font-family:Times New Roman;&quot;&gt;4&lt;/span&gt;.&lt;span style=&quot;font-family:Times New Roman;&quot;&gt;1311&lt;/span&gt;；新增 &lt;span style=&quot;font-family:Times New Roman;&quot;&gt;COPY&lt;/span&gt; &lt;span style=&quot;font-family:Times New Roman;&quot;&gt;8&lt;/span&gt;.&lt;span style=&quot;font-family:Times New Roman;&quot;&gt;2173&lt;/span&gt; &lt;span style=&quot;font-family:Times New Roman;&quot;&gt;MiB&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Times New Roman;&quot;&gt;4&lt;/span&gt; 例较 &lt;span style=&quot;font-family:Times New Roman;&quot;&gt;C3&lt;/span&gt; 更快但 &lt;span style=&quot;font-family:Times New Roman;&quot;&gt;COPY&lt;/span&gt; 更高" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=SimSun;fontSize=28.3;fontColor=#25394B;fontStyle=0;fillColor=#F7F8FA;strokeColor=#A6B0BA;strokeWidth=1.7;spacing=9;" vertex="1" parent="1">
